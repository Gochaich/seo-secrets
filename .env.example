# Скопируйте этот файл в .env.local и заполните значения.
# .env.local в репозиторий не попадает — он в .gitignore.
# На Vercel те же переменные задаются в Project Settings → Environment Variables.

# --- Этап 2: сейчас ---------------------------------------------------------

# Индексация поисковиками. На тестовом домене должно быть выключено (пусто или false).
# Включается один раз, на боевом домене, на этапе 8.
NEXT_PUBLIC_ALLOW_INDEXING=

# Полный адрес сайта, нужен для canonical, sitemap и og-разметки.
# ОБЯЗАТЕЛЬНО с протоколом и БЕЗ слэша на конце: https://seo-secrets.kz
# На тестовом домене — адрес *.vercel.app: https://seo-secrets.vercel.app
# Не задан или пуст — берётся боевой адрес https://seo-secrets.kz.
NEXT_PUBLIC_SITE_URL=https://seo-secrets.kz

# --- Этап 5: воронка заявок -------------------------------------------------

# База заявок (Supabase → Project Settings → API)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Уведомление команде. Бот создаётся у @BotFather, chat_id — id рабочего чата
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Письмо клиенту (resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Антиспам (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Лимит запросов (upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Дубль лидов в таблицу, пока нет CRM
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# CRM. Пусто = отправка выключена. Заполнится, когда появится CRM
CRM_WEBHOOK_URL=

# --- Этап 6: ИИ на сайте ----------------------------------------------------

# console.anthropic.com
ANTHROPIC_API_KEY=
# Потолок расходов: сколько сообщений разрешено одному посетителю в сутки
AI_MESSAGES_PER_VISITOR_PER_DAY=20

# Экспресс-аудит сайта (бесплатный ключ в Google Cloud Console)
PAGESPEED_API_KEY=

# --- Этап 7: аналитика ------------------------------------------------------

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=
